# =============================================================================
# Aurelius Autonomous Workbench - Environment Configuration
# =============================================================================

# --- LLM Configuration ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
LLM_PROVIDER=auto
LLM_MODEL=claude-sonnet-4-20250514
LOCAL_MODEL=nemotron:latest

# --- NemoClaw (Sandbox & Policy Router) ---
OPENSHELL_ENDPOINT=http://localhost:2376
PRIVACY_ROUTER_CONFIG=local-first
AUTONOMY_CONFIG=supervised

# --- OPA (Open Policy Agent) ---
OPA_ENDPOINT=http://localhost:8181
OPA_PORT=8181
OPA_LOG_LEVEL=info

# --- MinIO (S3-Compatible Object Storage) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USER=aurelius
MINIO_PASSWORD=changeme123
MINIO_USE_SSL=false

# --- Trigger.dev v3 ---
TRIGGER_API_KEY=tr_dev_placeholder
TRIGGER_API_URL=http://localhost:3030
TRIGGER_PROJECT_ID=aurelius-workbench

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# --- Ollama (Local LLM) ---
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_PORT=11434

# --- Dashboard ---
DASHBOARD_PORT=8501
WORKBENCH_PORT=8500

# --- Node Environment ---
NODE_ENV=development
