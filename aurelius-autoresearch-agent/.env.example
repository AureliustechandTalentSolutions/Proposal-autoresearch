# LLM Provider Configuration
# Options: claude, openai, ollama
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-4-20250514

# Anthropic (for Claude provider)
ANTHROPIC_API_KEY=

# OpenAI-compatible (for OpenAI/LeapfrogAI provider)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Ollama (for local LLM provider)
OLLAMA_BASE_URL=http://localhost:11434

# Dashboard
DASHBOARD_PORT=8501
